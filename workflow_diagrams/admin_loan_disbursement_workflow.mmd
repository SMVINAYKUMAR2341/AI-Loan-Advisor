sequenceDiagram
    autonumber
    title Admin Loan Management & Disbursement Workflow

    participant Admin as Admin User
    participant AD as Admin Dashboard
    participant BE as Backend API
    participant DB as Database
    participant C as Customer
    participant Bank as Bank System

    %% ============================================
    %% PHASE 1: ADMIN LOGIN
    %% ============================================
    rect rgb(240, 240, 240)
        Note over Admin,DB: PHASE 1: Admin Authentication
        Admin->>AD: Open Admin Portal
        AD-->>Admin: Show Login Page
        Admin->>AD: Enter Credentials<br/>(email + password)
        AD->>BE: POST /admin/login
        BE->>DB: Verify against admin_users table
        DB-->>BE: Admin Validated
        BE-->>AD: JWT Token + Admin Profile
        AD-->>Admin: Navigate to Dashboard
    end

    %% ============================================
    %% PHASE 2: DASHBOARD OVERVIEW
    %% ============================================
    rect rgb(230, 245, 255)
        Note over Admin,DB: PHASE 2: Admin Dashboard Overview
        AD->>BE: GET /admin/dashboard/stats
        BE->>DB: Aggregate Statistics:<br/>• Total Applications<br/>• Pending Reviews<br/>• Approved Today<br/>• Total Disbursed Amount
        DB-->>BE: Stats Data
        BE-->>AD: Dashboard Stats
        AD-->>Admin: Display Overview Cards
    end

    %% ============================================
    %% PHASE 3: LOAN APPLICATION MANAGEMENT
    %% ============================================
    rect rgb(255, 245, 230)
        Note over Admin,DB: PHASE 3: Loan Applications Management
        
        Admin->>AD: Navigate to "Loan Applications"
        AD->>BE: GET /admin/applications?status=PENDING_REVIEW
        BE->>DB: Query Applications
        DB-->>BE: Application List
        BE-->>AD: Applications Data
        AD-->>Admin: Display Applications Table
        
        Admin->>AD: Click Application Row
        AD->>BE: GET /admin/applications/{id}/full
        BE->>DB: Get Full Details:<br/>• Customer Profile<br/>• Loan Features<br/>• ML Prediction<br/>• Decision Factors
        DB-->>BE: Complete Data
        BE-->>AD: Application Details
        AD-->>Admin: Display Loan Details Panel
        
        Note over Admin: Review ML Analysis:<br/>• Approval Probability<br/>• Credit Score Estimate<br/>• Income Analysis<br/>• Risk Factors
        
        alt Approve Application
            Admin->>AD: Click "Approve"
            Admin->>AD: Enter Justification
            AD->>BE: POST /admin/applications/{id}/decision<br/>decision: APPROVED<br/>justification: "Low risk profile"
            BE->>DB: Update Application Status
            BE->>DB: Create Review Record
            BE->>DB: Log Audit Entry
            DB-->>BE: All Updated
            BE-->>AD: Approval Confirmed
            AD-->>Admin: ✅ Application Approved
            
        else Request Documents
            Admin->>AD: Click "Request Documents"
            Admin->>AD: Select Document Types:<br/>• ITR<br/>• Bank Statement<br/>• Salary Slips
            AD->>BE: POST /admin/applications/{id}/request-documents<br/>document_types: "ITR,Bank Statement"
            BE->>DB: Update Status: DOCUMENTS_REQUIRED
            BE->>DB: Create Notification
            DB-->>BE: Status Updated
            BE-->>AD: Request Sent
            AD-->>Admin: 📄 Documents Requested
            
        else Reject Application
            Admin->>AD: Click "Reject"
            Admin->>AD: Enter Rejection Reason
            AD->>BE: POST /admin/applications/{id}/decision<br/>decision: REJECTED<br/>justification: "High debt ratio"
            BE->>DB: Update Status: REJECTED
            BE->>DB: Log Audit Entry
            DB-->>BE: Status Updated
            BE-->>AD: Rejection Recorded
            AD-->>Admin: ❌ Application Rejected
        end
    end

    %% ============================================
    %% PHASE 4: DOCUMENT VERIFICATION
    %% ============================================
    rect rgb(230, 255, 230)
        Note over Admin,DB: PHASE 4: KYC Document Verification
        
        Admin->>AD: Navigate to "Documents"
        AD->>BE: GET /admin/documents?status=PENDING_VERIFICATION
        BE->>DB: Query Pending Documents
        DB-->>BE: Documents List
        BE-->>AD: Documents Data
        AD-->>Admin: Display Documents Table
        
        Admin->>AD: View Document
        AD-->>Admin: Display Document Preview<br/>(PDF/Image)
        
        Note over Admin: Verify Document:<br/>• Check Authenticity<br/>• Verify Name Match<br/>• Check Validity Date
        
        alt Verify Document
            Admin->>AD: Click "Verify"
            AD->>BE: POST /admin/documents/{id}/verify<br/>is_valid: true<br/>comments: "Verified"
            BE->>DB: Update status: VERIFIED
            DB-->>BE: Updated
            BE-->>AD: Verification Complete
            AD-->>Admin: ✅ Document Verified
            
        else Reject Document
            Admin->>AD: Click "Reject"
            Admin->>AD: Enter Rejection Reason
            AD->>BE: POST /admin/documents/{id}/verify<br/>is_valid: false<br/>comments: "Name mismatch"
            BE->>DB: Update status: REJECTED
            DB-->>BE: Updated
            BE-->>AD: Rejection Recorded
            AD-->>Admin: ❌ Document Rejected
        end
    end

    %% ============================================
    %% PHASE 5: LOAN DISBURSEMENT
    %% ============================================
    rect rgb(255, 230, 255)
        Note over Admin,Bank: PHASE 5: Loan Disbursement
        
        Admin->>AD: Navigate to "Disbursement"
        AD->>BE: GET /admin/applications?status=KYC_COMPLETED
        BE->>DB: Query Ready for Disbursement
        DB-->>BE: Eligible Applications
        BE-->>AD: Applications List
        AD-->>Admin: Display Pending Disbursements
        
        Admin->>AD: Select Application
        AD->>BE: GET /admin/applications/{id}/full
        BE-->>AD: Application + Bank Details
        AD-->>Admin: Show Customer Bank Details<br/>(Account: ****1234, IFSC: HDFC0001234)
        
        Note over Admin,Bank: Manual Bank Transfer<br/>(Outside System)
        Admin->>Bank: Initiate NEFT/RTGS Transfer
        Bank-->>Admin: Transaction Reference:<br/>TXN20260112123456
        
        Admin->>AD: Enter Transaction Reference
        Admin->>AD: Click "Process Disbursement"
        AD->>BE: POST /admin/disbursement/{app_id}<br/>transaction_ref: TXN20260112123456<br/>remarks: "Disbursed via NEFT"
        
        BE->>DB: Create Disbursement Record
        Note over BE: Disbursement Record:<br/>• Amount<br/>• Transaction Ref<br/>• Processed At<br/>• Status: COMPLETED
        
        BE->>DB: Update Application:<br/>status: DISBURSED
        DB-->>BE: All Updated
        
        BE->>DB: Create EMI Schedule<br/>(Based on loan terms)
        DB-->>BE: EMI Schedule Created
        
        BE->>DB: Create Notification for Customer
        DB-->>BE: Notification Created
        
        BE-->>AD: Disbursement Processed
        AD-->>Admin: 💰 Disbursement Complete!
        
        Note over C: Customer receives:<br/>1. Bank Credit<br/>2. Notification<br/>3. EMI Schedule
    end

    %% ============================================
    %% PHASE 6: REPORTS & MONITORING
    %% ============================================
    rect rgb(255, 255, 230)
        Note over Admin,DB: PHASE 6: Reports & Analytics
        
        Admin->>AD: Navigate to "Reports"
        AD->>BE: GET /admin/reports/stats
        BE->>DB: Aggregate Data:<br/>• Monthly Applications<br/>• Approval Rate<br/>• Disbursement Amount<br/>• Collection Rate
        DB-->>BE: Statistics
        BE-->>AD: Report Data
        AD-->>Admin: Display Charts & Tables
        
        Admin->>AD: Download Report PDF
        AD->>BE: GET /admin/reports/download
        BE-->>AD: PDF Report
        AD-->>Admin: Download Complete
    end
