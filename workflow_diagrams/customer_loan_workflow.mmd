sequenceDiagram
    autonumber
    title Customer Loan Application Complete Workflow

    participant C as Customer
    participant FE as Frontend (Dashboard)
    participant BE as Backend API
    participant ML as ML Engine
    participant DB as Database
    participant Admin as Admin Dashboard

    %% ============================================
    %% PHASE 1: AUTHENTICATION
    %% ============================================
    rect rgb(230, 245, 255)
        Note over C,DB: PHASE 1: Customer Authentication
        C->>FE: Open Application
        FE->>C: Show Login/Signup Page
        
        alt New User Registration
            C->>FE: Enter Registration Details<br/>(Name, Email, Mobile, Password)
            FE->>BE: POST /signup
            BE->>DB: Create User Record<br/>Generate Customer ID (LA2025xxxx)
            DB-->>BE: User Created
            BE-->>FE: Return JWT Token
        else Existing User Login
            C->>FE: Enter Mobile + Password
            FE->>BE: POST /login
            BE->>DB: Verify Credentials
            DB-->>BE: User Validated
            BE-->>FE: Return JWT Token + Customer ID
        end
        FE-->>C: Navigate to Dashboard
    end

    %% ============================================
    %% PHASE 2: LOAN APPLICATION
    %% ============================================
    rect rgb(255, 245, 230)
        Note over C,DB: PHASE 2: Loan Application Submission
        C->>FE: Navigate to "Apply for Loan"
        FE-->>C: Show Loan Application Form
        
        C->>FE: Fill Loan Form:<br/>• Loan Amount<br/>• Tenure (months)<br/>• Purpose<br/>• Income Details<br/>• Employment Type<br/>• CIBIL Score
        
        FE->>BE: POST /loan-applications<br/>(Submit Application)
        
        Note over BE: Generate Tracking ID<br/>(RBI2026LA01 format)
        
        BE->>DB: Store Application in<br/>loan_applications table
        DB-->>BE: Application ID Created
        
        BE->>ML: Run ML Prediction<br/>loan_advisor.analyze()
        
        Note over ML: ML Analysis:<br/>• Credit Scoring<br/>• Risk Assessment<br/>• EMI Calculation<br/>• Debt-to-Income Ratio
        
        ML-->>BE: Return Prediction Result
        
        BE->>DB: Store Prediction in<br/>loan_predictions table
        DB-->>BE: Prediction Saved
    end

    %% ============================================
    %% PHASE 3: ML DECISION OUTCOMES
    %% ============================================
    rect rgb(230, 255, 230)
        Note over C,Admin: PHASE 3: ML Decision (3 Outcomes)
        
        alt Decision: APPROVED (Confidence >= 75%)
            BE-->>FE: Status: APPROVED<br/>Approval Probability: 75-100%
            FE-->>C: ✅ Loan Approved!<br/>Show KYC Required Message
            Note over C: Can proceed to KYC Process
            
        else Decision: PENDING_REVIEW (Confidence 50-74%)
            BE-->>FE: Status: PENDING_REVIEW<br/>Approval Probability: 50-74%
            FE-->>C: ⏳ Under Review<br/>Awaiting Admin Decision
            Note over Admin: Admin reviews application manually
            
        else Decision: REJECTED (Confidence < 50%)
            BE-->>FE: Status: REJECTED<br/>Approval Probability: < 50%
            FE-->>C: ❌ Loan Rejected<br/>Show Rejection Reasons<br/>(Decision Factors)
            Note over C: Application ends here<br/>Can apply again later
        end
    end

    %% ============================================
    %% PHASE 4: ADMIN REVIEW (For PENDING_REVIEW)
    %% ============================================
    rect rgb(255, 230, 255)
        Note over Admin,DB: PHASE 4: Admin Review (PENDING Applications)
        
        Admin->>BE: GET /admin/applications<br/>(Fetch Pending Applications)
        BE->>DB: Query PENDING_REVIEW apps
        DB-->>BE: Application List
        BE-->>Admin: Display Applications
        
        Admin->>BE: GET /admin/applications/{id}/full
        BE->>DB: Get Complete Details<br/>(Customer + Loan + ML Features)
        DB-->>BE: Full Application Data
        BE-->>Admin: Display Full Details
        
        Admin->>Admin: Review Application:<br/>• ML Prediction Details<br/>• Decision Factors<br/>• Risk Assessment
        
        alt Admin Approves
            Admin->>BE: POST /admin/applications/{id}/decision<br/>decision: "APPROVED"
            BE->>DB: Update Status to APPROVED
            DB-->>BE: Status Updated
            BE-->>Admin: Approval Confirmed
            BE->>DB: Log Audit Entry
            Note over C: Customer can now proceed to KYC
            
        else Admin Requests Documents
            Admin->>BE: POST /admin/applications/{id}/request-documents<br/>document_types: "ITR, Bank Statement"
            BE->>DB: Update Status to DOCUMENTS_REQUIRED
            DB-->>BE: Status Updated
            BE-->>Admin: Document Request Sent
            Note over C: Customer needs to provide documents
            
        else Admin Rejects
            Admin->>BE: POST /admin/applications/{id}/decision<br/>decision: "REJECTED"
            BE->>DB: Update Status to REJECTED
            DB-->>BE: Status Updated
            BE-->>Admin: Rejection Recorded
            Note over C: Application Rejected
        end
    end

    %% ============================================
    %% PHASE 5: LOAN REPORT
    %% ============================================
    rect rgb(255, 255, 230)
        Note over C,BE: PHASE 5: Loan Report Generation
        
        C->>FE: Click "Download Report"
        FE->>BE: GET /loan-report/{application_id}
        
        Note over BE: report_generator.py<br/>Generate PDF Report:<br/>• Applicant Details<br/>• Loan Terms<br/>• ML Decision Factors<br/>• EMI Schedule<br/>• CIBIL Comparison
        
        BE-->>FE: PDF Report (StreamingResponse)
        FE-->>C: Download PDF Report
        
        alt QR Code Download
            C->>FE: Click "Get QR Code"
            FE->>BE: GET /loan-report/{id}/qr
            BE-->>FE: QR Code Image
            FE-->>C: Display QR for Mobile Download
        end
    end
