# Backend Environment Variables for Production
# Copy this to .env and fill in your values

# Neon PostgreSQL Connection String (using the one you created)
# Note: I added +asyncpg so it works with the code
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?sslmode=require

# JWT Secret Key (generate a random 32+ character string)
SECRET_KEY=your-super-secret-key-here-min-32-chars

# OpenRouter API Key for Chatbot (from openrouter.ai)
OPENROUTER_API_KEY=your-openrouter-key-here
