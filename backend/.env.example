# Backend Environment Variables for Production
# Copy this to .env and fill in your values

# Neon PostgreSQL Connection String (using the one you created)
# Note: I added +asyncpg so it works with the code
DATABASE_URL=******host/dbname?sslmode=require

# Database pool tuning
DB_POOL_SIZE=40
DB_MAX_OVERFLOW=80
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_COMMAND_TIMEOUT=60
DB_CONNECT_TIMEOUT=30
DB_USE_PGBOUNCER=false

# Prediction concurrency controls
PREDICTION_MAX_CONCURRENCY=100
PREDICTION_QUEUE_TIMEOUT_SECONDS=2.0

# Multi-worker backend settings
WEB_CONCURRENCY=4
KEEP_ALIVE_TIMEOUT=75

# JWT Secret Key (generate a random 32+ character string)
SECRET_KEY=your-super-secret-key-here-min-32-chars

# OpenRouter API Key for Chatbot (from openrouter.ai)
OPENROUTER_API_KEY=your-openrouter-key-here
